# Copy this file to .env (cp .env.example .env). Restart `npm run dev` after changing it.

# Where the backend runs. Testing on a phone on the same Wi-Fi? Use your computer's
# IP address instead, e.g. http://192.168.0.5:8000 (and add the frontend's address
# to CORS_ORIGINS in backend/.env).
VITE_API_URL=http://localhost:8000

# The demo shop. `python -m app.seed` in backend/ prints its id (1 on a fresh database).
VITE_SHOP_ID=1
