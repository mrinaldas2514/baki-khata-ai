# Copy this file to .env (cp .env.example .env). Restart `npm run dev` after changing it.

# Where the backend runs. Testing on a phone on the same Wi-Fi? Use your computer's
# IP address instead, e.g. http://192.168.0.5:8000 (and add the frontend's address
# to CORS_ORIGINS in backend/.env).
VITE_API_URL=http://localhost:8000

# Public demo only: show "Demo login: 01700000000 / demo1234" on the login screen (the backend
# makes that login with SEED_DEMO_ON_START=true). Read at build time.
VITE_SHOW_DEMO_LOGIN=false

# There is no shop setting any more: the app uses the shop of whoever logs in.
