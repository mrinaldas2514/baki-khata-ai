# Copy this file to .env and adjust as needed. Never commit the real .env.

APP_NAME="Baki Khata AI"
# Set to "production" on a real server. The backend then refuses to start unless JWT_SECRET is
# set, DATABASE_URL is PostgreSQL and CORS_ORIGINS lists the frontend's https:// address(es);
# the interactive API docs (/docs) are off and responses get an HSTS header.
ENVIRONMENT=development

# Signs the login tokens. Anyone who knows it can log in as ANY shopkeeper, so:
#   - use a long random value (at least 32 characters), different on every server
#   - never commit it, never share it
# Generate one (copy the output here):
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# Left empty in development, a random one is made at each start (and everyone is logged out
# whenever the backend restarts).
JWT_SECRET=
# How long a login lasts, in minutes (10080 = 7 days). "Logout" ends it at once.
JWT_EXPIRE_MINUTES=10080

# SQLite file in the backend folder (default, for development).
DATABASE_URL=sqlite:///./baki_khata.db
# PostgreSQL (required in production). postgres:// and postgresql:// URLs work as they are.
# DATABASE_URL=postgresql://baki_user:change-me@localhost:5432/baki_khata

# Shop's local timezone; decides what "today" means on the dashboard.
# Bangladesh: Asia/Dhaka, India: Asia/Kolkata
APP_TIMEZONE=Asia/Dhaka

# Log every SQL statement (useful while debugging).
SQL_ECHO=false

# Browser origins allowed to call the API (the frontend). Comma-separated, no trailing slash.
# Left empty in development: http://localhost:5173 and http://127.0.0.1:5173.
# Production: the frontend's exact address(es), https:// only, e.g. https://baki-khata.vercel.app
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Largest request body in bytes (POST /transcribe may be STT_MAX_AUDIO_BYTES + 64 KB instead).
MAX_REQUEST_BYTES=131072

# Which parser POST /shops/{id}/parse uses:
#   auto - Groq when GROQ_API_KEY is set, otherwise the rule-based demo parser (default)
#   groq - always Groq; without a key the parse endpoint returns 503
#   fake - always the rule-based demo parser: no AI, no key, good enough to try the app
LLM_PROVIDER=auto

# AI parsing with Groq. Get a key at https://console.groq.com/keys
GROQ_API_KEY=
# Any chat model Groq serves that supports JSON mode (see https://console.groq.com/docs/models).
# If Groq retires it, the backend logs a clear error at startup; change it here.
GROQ_MODEL=openai/gpt-oss-120b
# Seconds to wait for the model before giving up.
LLM_TIMEOUT_SECONDS=20

# Voice input on the server (POST /transcribe): Groq's Whisper speech-to-text, same GROQ_API_KEY.
# Without a key the endpoint returns 503 and the app uses the browser's speech recognition only.
# whisper-large-v3 is the most accurate for Bangla; whisper-large-v3-turbo is faster and cheaper.
GROQ_STT_MODEL=whisper-large-v3
# Limits for one recording (bytes, seconds).
STT_MAX_AUDIO_BYTES=1000000
STT_MAX_AUDIO_SECONDS=30

# Country calling code for WhatsApp reminder links (local numbers like 01711-000001).
# Bangladesh: 880, India: 91
PHONE_COUNTRY_CODE=880

# Rate limits (per client IP for login/register, per shop for parse/transcribe). In memory:
# per server process, reset on restart. Set RATE_LIMIT_ENABLED=false to switch them off.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_LOGIN_PER_MINUTE=10
RATE_LIMIT_REGISTER_PER_HOUR=10
RATE_LIMIT_PARSE_PER_MINUTE=30
RATE_LIMIT_TRANSCRIBE_PER_MINUTE=15
